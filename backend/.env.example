# Database Configuration
DATABASE_URL=postgresql://fleetflow_user:fleetflow123@localhost:5432/fleetflow_db

# Security & JWT Configuration
SECRET_KEY=dev-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis & External Services
REDIS_URL=redis://localhost:6379/0
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Frontend URL (Used in verification links)
FRONTEND_URL=http://localhost:5173

# Email Verification & SMTP Configuration
# (If SMTP_HOST is blank, the app runs in dev mode and logs verification links to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fleetflow.com
SMTP_USE_TLS=true

# Verification Token Expiry & Cooldown (in hours and seconds)
EMAIL_VERIFICATION_EXPIRE_HOURS=24
RESEND_COOLDOWN_SECONDS=60
