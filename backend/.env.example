# Database Configuration
DATABASE_URL=postgresql://fleetflow_user:fleetflow123@localhost:5432/fleetflow_db

# Security & JWT Configuration
SECRET_KEY=dev-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis & External Services
REDIS_URL=redis://localhost:6379/0
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Frontend URL (Used in verification links)
FRONTEND_URL=http://localhost:5173

# Email Verification & SMTP Configuration
# For Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=FleetFlow
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fleetflow.com
SMTP_FROM_NAME=FleetFlow
SMTP_USE_TLS=true

# Verification Token/Code Expiry & Cooldown (in minutes and seconds)
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
RESEND_COOLDOWN_SECONDS=60
