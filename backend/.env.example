# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://fleetflow_user:your_password@localhost:5432/fleetflow_db

# Used starting Step 7 (JWT Authentication) — safe to set now.
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
